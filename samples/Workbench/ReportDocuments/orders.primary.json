{
  "title": "Default",
  "primary": true,
  "state": {
    "activeTable": "orders",
    "tables": {
      "orders": {
        "from": "definition",
        "schema": null,
        "composables": [
          { "kind": "compute", "computed": [
            { "id": "c1", "label": "With Tax", "expr": "ROUND(AMOUNT * 1.0825, 2)" }
          ] },
          { "kind": "sort", "sorts": [
            { "col": "ORDER_DATE", "dir": "desc" }
          ] },
          { "kind": "select", "columns": [
            "ORDER_ID", "CUSTOMER", "REGION", "STATUS", "AMOUNT", "ORDER_DATE", "NOTES", "c1"
          ] },
          { "kind": "formats", "formats": {
            "ORDER_ID": {
              "displayAs": "link",
              "urlColumn": "ORDER_URL",
              "textColumn": "ORDER_ID"
            },
            "AMOUNT": { "mask": "currency:CAD", "classes": [ "amount-column" ] },
            "c1": { "mask": "currency:CAD", "classes": [ "amount-column" ] }
          } }
        ]
      },
      "groupBy": {
        "from": "orders",
        "schema": null,
        "composables": [
          {
            "kind": "group",
            "by": [ "REGION" ],
            "values": [
              { "id": "m1", "col": "AMOUNT", "fn": "sum" }
            ]
          },
          { "kind": "sort", "sorts": [ { "col": "m1", "dir": "desc" } ] }
        ]
      },
      "pivot": {
        "from": "orders",
        "schema": null,
        "composables": [
          {
            "kind": "pivot",
            "rows": [ "REGION" ],
            "cols": [ "STATUS" ],
            "values": [
              { "id": "m1", "col": "AMOUNT", "fn": "sum" }
            ]
          }
        ]
      },
      "chart": {
        "from": "orders",
        "schema": null,
        "composables": [
          {
            "kind": "chart",
            "type": "bar",
            "label": "STATUS",
            "value": "AMOUNT",
            "fn": "sum",
            "sort": { "by": "value", "dir": "desc" }
          }
        ]
      }
    }
  }
}
