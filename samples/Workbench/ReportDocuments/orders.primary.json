{
  "title": "Default",
  "primary": true,
  "state": {
    "activeTable": "orders",
    "tables": {
      "orders": {
        "from": "definition",
        "schema": null,
        "composables": [
          { "kind": "compute", "computed": [
            { "id": "c1", "label": "With Tax", "expr": "ROUND(AMOUNT * 1.0825, 2)" }
          ] },
          { "kind": "sort", "sorts": [
            { "col": "ORDER_DATE", "dir": "desc" }
