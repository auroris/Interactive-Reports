{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "InteractiveReport": {
    "WhoamiEnabled": true,
    "Administrators": [ "workbench-dev" ],
    "SavedReports": {
      "connection": "SampleDb"
    },
    "Reports": {
      "orders": {
        "title": "Orders",
        "connection": "SampleDb",
        "sql": "SELECT ORDER_ID, CUSTOMER, REGION, STATUS, AMOUNT, ORDER_DATE, NOTES, '/orders/' || ORDER_ID AS ORDER_URL FROM ORDERS",
        "columnLabels": {
          "ORDER_ID": "Order #",
          "CUSTOMER": "Customer Name",
          "ORDER_DATE": "Ordered On"
        },
        "authorization": { "allowAnonymous": true },
        "documentFiles": [ "ReportDocuments/orders.primary.json" ]
      },
      "order-feed": {
        "title": "Order Feed (minimal config)",
        "dataSource": "SampleDb",
        "sql": "SELECT ORDER_ID, CUSTOMER, AMOUNT FROM ORDERS",
        "columnLabels": { "ORDER_ID": "Order #" },
        "authorization": { "allowAnonymous": true }
      },
      "orders-kiosk": {
        "title": "Orders Kiosk (feature whitelist)",
        "connection": "SampleDb",
        "sql": "SELECT ORDER_ID, CUSTOMER, REGION, AMOUNT, ORDER_DATE FROM ORDERS",
        "columnLabels": { "ORDER_ID": "Order #" },
        "authorization": { "allowAnonymous": true },
        "features": [ "search", "sort", "download" ],
        "defaultState": {
          "activeTable": "kiosk",
          "tables": {
            "kiosk": {
              "from": "definition",
              "schema": null,
              "composables": [
                { "kind": "filter", "filters": [ { "expr": "AMOUNT > 100" } ] },
                { "kind": "sort", "sorts": [ { "col": "ORDER_DATE", "dir": "desc" } ] }
              ]
            }
          }
        }
      },
      "big-orders": {
        "title": "Big Orders (over 5k)",
        "connection": "SampleDb",
        "sql": "SELECT ORDER_ID, CUSTOMER, REGION, AMOUNT, ORDER_DATE FROM ORDERS WHERE AMOUNT > 5000",
        "authorization": { "allowAnonymous": true },
        "defaultState": {
          "activeTable": "large",
          "tables": {
            "large": {
              "from": "definition",
              "schema": null,
              "composables": [
                { "kind": "sort", "sorts": [ { "col": "AMOUNT", "dir": "desc" } ] },
                { "kind": "break", "breaks": [ "REGION" ] },
                { "kind": "aggregate", "aggregates": [ { "col": "AMOUNT", "fn": "sum" }, { "col": "AMOUNT", "fn": "avg" } ] }
              ]
            }
          }
        }
      },
      "orders-managed": {
        "title": "Orders (managed columns)",
        "connection": "SampleDb",
        "sql": "SELECT ORDER_ID, CUSTOMER, REGION, STATUS, AMOUNT, ORDER_DATE, NOTES FROM ORDERS",
        "authorization": { "allowAnonymous": true },
        "editLink": {
          "urlTemplate": "/orders/{order_id}/edit",
          "label": "Edit order"
        },
        "columns": {
          "ORDER_ID": { "label": "Order #", "helpText": "Internal order number assigned at intake." },
          "NOTES": { "hideLabel": true, "sortable": false, "filterable": false }
        }
      },
      "regional-summary": {
        "title": "Regional Summary (policy-protected)",
        "connection": "SampleDb",
        "sql": "SELECT REGION, STATUS, AMOUNT, ORDER_DATE FROM ORDERS",
        "authorization": { "policy": "WorkbenchAdmins" },
        "defaultState": {
          "activeTable": "regional",
          "tables": {
            "regional": {
              "from": "definition",
              "schema": null,
              "composables": [
                { "kind": "break", "breaks": [ "REGION" ] },
                { "kind": "aggregate", "aggregates": [ { "col": "AMOUNT", "fn": "sum" }, { "col": "AMOUNT", "fn": "count" } ] }
              ]
            }
          }
        }
      }
    }
  }
}
