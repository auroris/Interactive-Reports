# Cloudflare Pages HTTP headers configuration
# https://developers.cloudflare.com/pages/configuration/headers/

# Security and cross-origin isolation headers for all routes
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin-allow-popups

# The bundles, the SQLite glue, and its WebAssembly binary are not content-hashed, so they
# revalidate like the HTML that references them: a deployment that changes the contract
# between ir.js and browser-server.js must never pair new HTML with a cached old bundle.
# Cloudflare answers unchanged files with 304s, so revalidation costs a round trip, not bytes.
/*.wasm
  Content-Type: application/wasm
  Cache-Control: public, max-age=0, must-revalidate

/*.js
  Cache-Control: public, max-age=0, must-revalidate

/*.js.map
  Cache-Control: public, max-age=0, must-revalidate

# HTML documents: always revalidate so deployments update immediately
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate
