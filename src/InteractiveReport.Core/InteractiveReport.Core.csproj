<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>AurorisNet.InteractiveReports.Core</PackageId>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Interactive Reports engine: report state model, validation, portable expression language, SqlKata composition, execution, and schema discovery. Host-facing packages build on this; most applications reference AurorisNet.InteractiveReports instead.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageReference Include="SqlKata" Version="4.0.1" />
  </ItemGroup>

</Project>
