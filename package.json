{
  "name": "interactive-reports-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:client",
    "build:client": "node scripts/build-client.mjs",
    "dev": "node scripts/build-client.mjs --watch",
    "test": "npm run test:unit",
    "test:unit": "npm run build:client && npm run unit",
    "unit": "node --test tests/ui/*.test.js",
    "test:ui": "npm run build:client && npm run e2e",
    "e2e": "playwright test",
    "verify": "npm run build:client && npm run unit && npm run e2e",
    "pack": "pwsh scripts/pack.ps1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "chart.js": "^4.5.1",
    "esbuild": "^0.28.1",
    "happy-dom": "^20.11.1"
  },
  "dependencies": {
    "big.js": "7.0.1",
    "intl-messageformat": "11.2.14"
  }
}
